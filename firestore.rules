rules_version = '2';

// The app has no sign-in, so anyone may play. These rules only allow the writes the
// app itself makes: creating, renaming and archiving leagues and adding players to them,
// adding players, creating tournaments and joining, leaving or ending them, starting games,
// scoring one goal at a time, swapping positions, undoing the last event of a game,
// closing a game once it is won and removing unfinished games. Nobody can change or delete players, remove anyone from a league,
// rewrite results or touch finished games.
service cloud.firestore {
  match /databases/{database}/documents {

    // To `target` goals (at most 20); `winBy: 2` asks for a two-goal lead, up to `max`
    // goals; `minutes` adds a time limit.
    function validMode(mode) {
      return mode.keys().hasOnly(['target', 'winBy', 'max', 'minutes'])
        && mode.target is int
        && mode.target >= 1
        && mode.target <= 20
        && mode.get('winBy', 1) in [1, 2]
        && (!('max' in mode) || (mode.max is int && mode.max >= mode.target && mode.max <= 30))
        && (!('minutes' in mode) || (mode.minutes is int && mode.minutes >= 1 && mode.minutes <= 60));
    }

    // The first `n` items (a range of an empty list is an error).
    function prefix(items, n) {
      return n == 0 ? [] : items[0:n];
    }

    match /players/{playerId} {
      allow read: if true;

      // Results are counted from the games, so players never change after being added.
      // `wins`/`loses` are legacy counters, accepted only as 0.
      allow create: if request.resource.data.keys().hasOnly(['name', 'wins', 'loses'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.get('wins', 0) == 0
        && request.resource.data.get('loses', 0) == 0;
    }

    match /leagues/{leagueId} {
      allow read: if true;

      // The league with id "legacy" holds the 2017 games, which have no `league` field.
      allow create: if request.resource.data.keys().hasOnly(['name', 'created', 'players', 'archived'])
        && leagueName(request.resource.data.name)
        && request.resource.data.created is string
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 100
        && request.resource.data.get('archived', false) is bool;

      // A league can be renamed, locked for new games (`archived`), given a minimum number of
      // games to appear in its ranking, deleted and restored (`deleted`, nothing is erased) and
      // gain players; nobody is removed from it. `gamesDeleted` remembers that its games were
      // deleted with it, to restore them together.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'players', 'archived', 'minGames', 'deleted', 'gamesDeleted'])
        && leagueName(request.resource.data.name)
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 100
        && request.resource.data.players.hasAll(resource.data.players)
        && request.resource.data.get('archived', false) is bool
        && request.resource.data.get('deleted', false) is bool
        && request.resource.data.get('gamesDeleted', false) is bool
        && (!('minGames' in request.resource.data)
          || (request.resource.data.minGames is int
            && request.resource.data.minGames >= 0
            && request.resource.data.minGames <= 100));

      function leagueName(name) {
        return name is string && name.size() > 0 && name.size() <= 60;
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['league', 'name', 'format', 'created', 'mode', 'teamSize', 'entries', 'teams', 'groups', 'bestOf'])
        && request.resource.data.league is string
        && request.resource.data.league.size() > 0
        && request.resource.data.league.size() <= 64
        && tournamentName(request.resource.data.name)
        && request.resource.data.format in ['series', 'open', 'king', 'dyp', 'roundRobin', 'rotation', 'cup']
        && request.resource.data.created is string
        && validMode(request.resource.data.mode)
        && request.resource.data.teamSize in [1, 2]
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 100
        && (!('teams' in request.resource.data)
          || (request.resource.data.teams is list
            && request.resource.data.teams.size() >= 2
            && request.resource.data.teams.size() <= 16))
        && (!('groups' in request.resource.data) || request.resource.data.groups in [0, 2])
        && (!('bestOf' in request.resource.data) || request.resource.data.bestOf in [3, 5]);

      // While it runs, a tournament can be renamed and ended, and players join or leave it one
      // at a time; how it is played never changes.
      allow update: if !('end' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'entries', 'end'])
        && tournamentName(request.resource.data.name)
        && (request.resource.data.entries == resource.data.entries
          || (request.resource.data.entries.size() == resource.data.entries.size() + 1
            && request.resource.data.entries.size() <= 100
            && prefix(request.resource.data.entries, resource.data.entries.size()) == resource.data.entries
            && validEntry(request.resource.data.entries[resource.data.entries.size()])))
        && (!('end' in request.resource.data) || request.resource.data.end is string);

      function tournamentName(name) {
        return name is string && name.size() > 0 && name.size() <= 60;
      }

      function validEntry(entry) {
        return entry.keys().hasOnly(['player', 'at', 'out'])
          && entry.player is string
          && entry.at is string
          && (!('out' in entry) || entry.out == true);
      }
    }

    match /games/{gameId} {
      allow read: if true;

      // Games from 2017 have no `league`, `mode`, `events` or `series`; they belong to the
      // legacy league and were played to 8.
      allow create: if request.resource.data.keys().hasOnly(['players', 'start', 'teams', 'league', 'mode', 'events', 'series', 'tournament'])
        && (!('league' in request.resource.data)
          || (request.resource.data.league is string
            && request.resource.data.league.size() > 0
            && request.resource.data.league.size() <= 64))
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 2
        && request.resource.data.players.size() <= 4
        && request.resource.data.start is string
        && request.resource.data.teams.keys().hasOnly(['red', 'blue'])
        && newTeam(request.resource.data.teams.red)
        && newTeam(request.resource.data.teams.blue)
        && (!('mode' in request.resource.data) || validMode(request.resource.data.mode))
        && (!('events' in request.resource.data) || request.resource.data.events == [])
        && (!('series' in request.resource.data) || validSeries(request.resource.data.series))
        && (!('tournament' in request.resource.data)
          || (request.resource.data.tournament is string
            && request.resource.data.tournament.size() > 0
            && request.resource.data.tournament.size() <= 64));

      // While the game is running, each write is one of: a goal (or own goal), a swap of
      // positions within a team, undoing the last event, or recording the result once the
      // game is won. Who plays, when the game started and how it is played never change.
      allow update: if !('end' in resource.data)
        && (scored() || swapped() || undone() || closed() || scoredAndClosed() || pausedOrResumed());

      // Only games that are still being played can be removed. Any game can be marked as
      // deleted (hidden from rankings and stats) and restored; nothing else changes with it.
      allow delete: if !('win' in resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
        && request.resource.data.deleted is bool;

      function before() {
        return resource.data;
      }

      function after() {
        return request.resource.data;
      }

      function changed() {
        return after().diff(before()).affectedKeys();
      }

      // One more goal or own goal. Games with an event log (from 2026) also append the
      // matching event; older games only count.
      function scored() {
        return changed().hasOnly(['teams', 'events'])
          && sameLineup(after().teams, before().teams)
          && notLower(after().teams, before().teams)
          && total(after().teams) == total(before().teams) + 1
          && !decided(before().teams)
          && ('events' in before()
            ? appended() && goalEvent(lastOf(after().events))
            : !('events' in after()));
      }

      // The defender and the attacker of one team change places, taking their goals along.
      function swapped() {
        return 'events' in before()
          && changed().hasOnly(['teams', 'events'])
          && appended()
          && swapEvent(lastOf(after().events))
          && isSwap(after().teams, before().teams, lastOf(after().events).team);
      }

      // The last event is removed and its goal taken back or its swap reversed.
      function undone() {
        return 'events' in before()
          && before().events.size() > 0
          && changed().hasOnly(['teams', 'events'])
          && after().events == prefix(before().events, before().events.size() - 1)
          && reverted(lastOf(before().events));
      }

      function closed() {
        return changed().hasOnly(['end', 'win'])
          && after().end is string
          && after().win in ['red', 'blue']
          && wins(after().teams, after().win);
      }

      // Apps from before October 2026 could score the deciding goal and close the game in
      // one write; games without an event log still accept that.
      function scoredAndClosed() {
        return !('events' in before())
          && changed().hasOnly(['teams', 'end', 'win'])
          && sameLineup(after().teams, before().teams)
          && notLower(after().teams, before().teams)
          && total(after().teams) <= total(before().teams) + 1
          && after().end is string
          && after().win in ['red', 'blue']
          && wins(after().teams, after().win);
      }

      // The clock stops (`paused`: when) and starts again (`pausedFor`: total pause, which
      // only grows); nothing else changes.
      function pausedOrResumed() {
        return changed().hasOnly(['paused', 'pausedFor'])
          && (!('paused' in after()) || after().paused is string)
          && (!('pausedFor' in after())
            || (after().pausedFor is int && after().pausedFor >= before().get('pausedFor', 0)));
      }

      function appended() {
        return after().events.size() == before().events.size() + 1
          && prefix(after().events, before().events.size()) == before().events;
      }

      function lastOf(events) {
        return events[events.size() - 1];
      }

      // `at`: milliseconds since the start of the game.
      function goalEvent(event) {
        return event.keys().hasOnly(['at', 'type', 'team', 'position', 'player'])
          && event.at is int
          && event.at >= 0
          && event.team in ['red', 'blue']
          && event.position in ['defence', 'offence']
          && event.player == before().teams[event.team][event.position].player
          && ((event.type == 'goal'
              && after().teams[event.team][event.position].goals
                == before().teams[event.team][event.position].goals + 1)
            || (event.type == 'own'
              && after().teams[event.team][event.position].ownGoals
                == before().teams[event.team][event.position].ownGoals + 1));
      }

      function swapEvent(event) {
        return event.keys().hasOnly(['at', 'type', 'team'])
          && event.type == 'swap'
          && event.at is int
          && event.at >= 0
          && event.team in ['red', 'blue'];
      }

      function reverted(event) {
        return event.type == 'swap'
          ? isSwap(after().teams, before().teams, event.team)
          : sameLineup(after().teams, before().teams)
            && notLower(before().teams, after().teams)
            && total(after().teams) == total(before().teams) - 1
            && ((event.type == 'goal'
                && after().teams[event.team][event.position].goals
                  == before().teams[event.team][event.position].goals - 1)
              || (event.type == 'own'
                && after().teams[event.team][event.position].ownGoals
                  == before().teams[event.team][event.position].ownGoals - 1));
      }

      function isSwap(next, prev, color) {
        return next.keys().hasOnly(['red', 'blue'])
          && next[color].keys().hasOnly(['defence', 'offence'])
          && next[color].defence == prev[color].offence
          && next[color].offence == prev[color].defence
          && next[other(color)] == prev[other(color)];
      }

      function newTeam(team) {
        return team.keys().hasOnly(['defence', 'offence'])
          && newScore(team.defence)
          && newScore(team.offence);
      }

      function newScore(score) {
        return score.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && score.player is string
          && score.goals == 0
          && score.ownGoals == 0;
      }

      // A best-of-3 or best-of-5 series; `id` is the id of its first game.
      function validSeries(series) {
        return series.keys().hasOnly(['id', 'bestOf', 'game'])
          && series.id is string
          && series.id.size() > 0
          && series.id.size() <= 64
          && series.bestOf in [3, 5]
          && series.game is int
          && series.game >= 1
          && series.game <= series.bestOf;
      }

      function sameLineup(next, prev) {
        return next.keys().hasOnly(['red', 'blue'])
          && next.red.keys().hasOnly(['defence', 'offence'])
          && next.blue.keys().hasOnly(['defence', 'offence'])
          && next.red.defence.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && next.red.offence.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && next.blue.defence.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && next.blue.offence.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && next.red.defence.player == prev.red.defence.player
          && next.red.offence.player == prev.red.offence.player
          && next.blue.defence.player == prev.blue.defence.player
          && next.blue.offence.player == prev.blue.offence.player;
      }

      function notLower(next, prev) {
        return scoreNotLower(next.red.defence, prev.red.defence)
          && scoreNotLower(next.red.offence, prev.red.offence)
          && scoreNotLower(next.blue.defence, prev.blue.defence)
          && scoreNotLower(next.blue.offence, prev.blue.offence);
      }

      function scoreNotLower(next, prev) {
        return next.goals >= prev.goals && next.ownGoals >= prev.ownGoals;
      }

      function mode() {
        return before().get('mode', {});
      }

      function other(color) {
        return color == 'red' ? 'blue' : 'red';
      }

      // Goals credited to `color`: its own goals plus the opponent's own goals.
      function goalsFor(teams, color) {
        return teams[color].defence.goals + teams[color].offence.goals
          + teams[other(color)].defence.ownGoals + teams[other(color)].offence.ownGoals;
      }

      // The target reached with the needed lead, or the cap reached.
      function reached(teams, color) {
        return goalsFor(teams, color) >= mode().get('target', 8)
          && (goalsFor(teams, color) - goalsFor(teams, other(color)) >= mode().get('winBy', 1)
            || goalsFor(teams, color) >= mode().get('max', 1000));
      }

      function decided(teams) {
        return reached(teams, 'red') || reached(teams, 'blue');
      }

      // In a timed game the team ahead may also be declared the winner: the rules cannot
      // check the clock, the app does.
      function wins(teams, color) {
        return reached(teams, color)
          || ('minutes' in mode() && goalsFor(teams, color) > goalsFor(teams, other(color)));
      }

      function total(teams) {
        return teams.red.defence.goals + teams.red.defence.ownGoals
          + teams.red.offence.goals + teams.red.offence.ownGoals
          + teams.blue.defence.goals + teams.blue.defence.ownGoals
          + teams.blue.offence.goals + teams.blue.offence.ownGoals;
      }
    }
  }
}
