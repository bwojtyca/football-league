rules_version = '2';

// The app has no sign-in, so anyone may play. These rules only allow the writes the
// app itself makes: creating, renaming and archiving leagues and adding players to them,
// adding players,
// starting games, scoring one goal at a time, closing a game once it is won and
// removing unfinished games. Nobody can change or delete players, remove anyone from a
// league, rewrite results or touch finished games.
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{playerId} {
      allow read: if true;

      // Results are counted from the games, so players never change after being added.
      // `wins`/`loses` are legacy counters, accepted only as 0.
      allow create: if request.resource.data.keys().hasOnly(['name', 'wins', 'loses'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.get('wins', 0) == 0
        && request.resource.data.get('loses', 0) == 0;
    }

    match /leagues/{leagueId} {
      allow read: if true;

      // The league with id "legacy" holds the 2017 games, which have no `league` field.
      allow create: if request.resource.data.keys().hasOnly(['name', 'created', 'players', 'archived'])
        && leagueName(request.resource.data.name)
        && request.resource.data.created is string
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 100
        && request.resource.data.get('archived', false) is bool;

      // A league can be renamed, archived and gain players; nobody is removed from it.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'players', 'archived'])
        && leagueName(request.resource.data.name)
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 100
        && request.resource.data.players.hasAll(resource.data.players)
        && request.resource.data.get('archived', false) is bool;

      function leagueName(name) {
        return name is string && name.size() > 0 && name.size() <= 60;
      }
    }

    match /games/{gameId} {
      allow read: if true;

      // Games from 2017 have no `league`; they belong to the legacy league.
      allow create: if request.resource.data.keys().hasOnly(['players', 'start', 'teams', 'league'])
        && (!('league' in request.resource.data)
          || (request.resource.data.league is string
            && request.resource.data.league.size() > 0
            && request.resource.data.league.size() <= 64))
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 2
        && request.resource.data.players.size() <= 4
        && request.resource.data.start is string
        && request.resource.data.teams.keys().hasOnly(['red', 'blue'])
        && newTeam(request.resource.data.teams.red)
        && newTeam(request.resource.data.teams.blue);

      // While the game is running: at most one goal per write, and the game can be closed
      // (`end` + `win`) only once the winning team has reached the target score. Who plays
      // and when the game started never change.
      allow update: if !('end' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams', 'end', 'win'])
        && sameLineup(request.resource.data.teams, resource.data.teams)
        && notLower(request.resource.data.teams, resource.data.teams)
        && total(request.resource.data.teams) <= total(resource.data.teams) + 1
        && ('end' in request.resource.data
          ? request.resource.data.end is string
            && wonBy(request.resource.data.teams, request.resource.data.win)
          : !('win' in request.resource.data));

      // Only games that are still being played can be removed.
      allow delete: if !('win' in resource.data);

      function newTeam(team) {
        return team.keys().hasOnly(['defence', 'offence'])
          && newScore(team.defence)
          && newScore(team.offence);
      }

      function newScore(score) {
        return score.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && score.player is string
          && score.goals == 0
          && score.ownGoals == 0;
      }

      function sameLineup(next, prev) {
        return next.keys().hasOnly(['red', 'blue'])
          && next.red.keys().hasOnly(['defence', 'offence'])
          && next.blue.keys().hasOnly(['defence', 'offence'])
          && next.red.defence.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && next.red.offence.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && next.blue.defence.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && next.blue.offence.keys().hasOnly(['player', 'goals', 'ownGoals'])
          && next.red.defence.player == prev.red.defence.player
          && next.red.offence.player == prev.red.offence.player
          && next.blue.defence.player == prev.blue.defence.player
          && next.blue.offence.player == prev.blue.offence.player;
      }

      function notLower(next, prev) {
        return scoreNotLower(next.red.defence, prev.red.defence)
          && scoreNotLower(next.red.offence, prev.red.offence)
          && scoreNotLower(next.blue.defence, prev.blue.defence)
          && scoreNotLower(next.blue.offence, prev.blue.offence);
      }

      function scoreNotLower(next, prev) {
        return next.goals >= prev.goals && next.ownGoals >= prev.ownGoals;
      }

      function wonBy(teams, color) {
        return (color == 'red' && goalsFor(teams.red, teams.blue) >= 8)
          || (color == 'blue' && goalsFor(teams.blue, teams.red) >= 8);
      }

      // Goals credited to `team`: its own goals plus the opponent's own goals.
      function goalsFor(team, opponent) {
        return team.defence.goals + team.offence.goals
          + opponent.defence.ownGoals + opponent.offence.ownGoals;
      }

      function total(teams) {
        return teams.red.defence.goals + teams.red.defence.ownGoals
          + teams.red.offence.goals + teams.red.offence.ownGoals
          + teams.blue.defence.goals + teams.blue.defence.ownGoals
          + teams.blue.offence.goals + teams.blue.offence.ownGoals;
      }
    }
  }
}
