{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "football-league": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "fl",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "brackets-viewer.min.{js,css}",
                "input": "node_modules/brackets-viewer/dist",
                "output": "vendor/brackets-viewer"
              }
            ],
            "styles": [
              "@fontsource/archivo/400.css",
              "@fontsource/archivo/500.css",
              "@fontsource/archivo/600.css",
              "@fontsource/archivo/700.css",
              "@fontsource/archivo/800.css",
              "material-icons/iconfont/filled.css",
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "@messageformat/core",
              "brackets-manager",
              "brackets-memory-db",
              "brackets-model"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "emulator": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.emulator.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "football-league:build:production"
            },
            "development": {
              "buildTarget": "football-league:build:development"
            },
            "emulator": {
              "buildTarget": "football-league:build:development,emulator"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
